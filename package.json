{
  "name": "wangbo-promotion-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:init": "npx cap init \"王博晋升之路跑酷\" wangbo.runner --web-dir=dist --npm-client npm",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "tauri:init": "npx @tauri-apps/cli init --ci",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "build:minigame": "node scripts/build-minigame.mjs"
  },
  "dependencies": {
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@tauri-apps/cli": "^2.9.2",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}