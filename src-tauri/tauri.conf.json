{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "wangbo-promotion-runner",
  "version": "0.1.0",
  "identifier": "wangbo.runner.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "王博晋升之路 · 跑酷",
        "width": 960,
        "height": 540,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
